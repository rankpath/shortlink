# Short Link — copy to .env (or set these in your host's environment panel)

# Required. Password for the dashboard. The dashboard and API stay disabled until this is set.
ADMIN_PASSWORD=change-me

# Optional. Bearer token for the REST API (Authorization: Bearer <key>). Leave empty to disable API-key access.
API_KEY=

# Recommended. Public origin(s) of your short links, comma separated. The first one is the default.
# Example with two domains: https://shortlink.rank-path.com,https://go.example.com
SHORT_DOMAINS=https://shortlink.rank-path.com

# Optional. Set to true when running behind a reverse proxy / cPanel / Cloudflare so client IPs and https are detected.
TRUST_PROXY=true

# Optional. Allow anonymous visitors to shorten links on the home page (20 per hour per IP). Default false.
PUBLIC_SHORTEN=false

# Optional. Time zone used for the daily click buckets.
TZ=Asia/Bangkok

# Optional. Where links.json and clicks.ndjson are stored. Default ./data
# DATA_DIR=/var/lib/scout-link

# Optional. Port and bind address. Defaults 3000 and 0.0.0.0
# PORT=3000
# HOST=0.0.0.0

# Optional. Secret for session cookies. Defaults to ADMIN_PASSWORD. Set a long random string in production.
# SESSION_SECRET=
